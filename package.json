{
    "name": "@rentnerkev/inputs",
    "version": "2.5.0",
    "description": "Controlled React input components with validation, icons, length counters, and Tailwind design hooks.",
    "author": "RentnerKev",
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "tailwind.css",
        "styles"
    ],
    "sideEffects": [
        "./tailwind.css",
        "./styles/*.css"
    ],
    "scripts": {
        "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc && bun scripts/build-css.mjs",
        "typecheck": "tsc --noEmit && bun run typecheck:automation",
        "typecheck:api": "tsc --noEmit --project type-tests/tsconfig.json",
        "prepare": "bun run build",
        "pack:check": "bun pm pack --dry-run",
        "pack:consumer": "node scripts/verify-package.mjs",
        "playground:dev": "bun --cwd playground dev",
        "playground:build": "bun --cwd playground build",
        "e2e": "playwright test",
        "lint": "oxlint src scripts type-tests playground/src playwright.config.ts .github/scripts",
        "lint:fix": "oxlint --fix src scripts type-tests playground/src playwright.config.ts .github/scripts",
        "format": "oxfmt src scripts type-tests playground README.md package.json tailwind.css styles/theme.css tsconfig.json playwright.config.ts .oxlintrc.json .oxfmtrc.json bunfig.toml .github",
        "format:check": "oxfmt --check src scripts type-tests playground README.md package.json tailwind.css styles/theme.css tsconfig.json playwright.config.ts .oxlintrc.json .oxfmtrc.json bunfig.toml .github",
        "test": "bun test",
        "verify": "bun run typecheck && bun run typecheck:api && bun run lint && bun run format:check && bun run test && bun run build && bun run pack:check && bun run pack:consumer && bun run e2e",
        "typecheck:automation": "tsc --noEmit -p .github/scripts/tsconfig.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerInputs.git"
    },
    "homepage": "https://packages.rentner.dev/packages/inputs",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerInputs/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "dependencies": {
        "@rentnerkev/tooltips": "^2.0.7",
        "lucide-react": "^1.52.0"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.3"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./tailwind.css": "./tailwind.css",
        "./input": {
            "import": "./dist/Components/CustomInput.js",
            "types": "./dist/Components/CustomInput.d.ts"
        },
        "./text-input": {
            "import": "./dist/Components/Inputs/TextInput.js",
            "types": "./dist/Components/Inputs/TextInput.d.ts"
        },
        "./search-input": {
            "import": "./dist/Components/Inputs/SearchInput.js",
            "types": "./dist/Components/Inputs/SearchInput.d.ts"
        },
        "./native-time-input": {
            "import": "./dist/Components/Inputs/NativeTimeInput.js",
            "types": "./dist/Components/Inputs/NativeTimeInput.d.ts"
        },
        "./checkbox-input": {
            "import": "./dist/Components/Inputs/PrimitiveInputs.js",
            "types": "./dist/Components/Inputs/PrimitiveInputs.d.ts"
        },
        "./radio-input": {
            "import": "./dist/Components/Inputs/PrimitiveInputs.js",
            "types": "./dist/Components/Inputs/PrimitiveInputs.d.ts"
        },
        "./range-input": {
            "import": "./dist/Components/Inputs/PrimitiveInputs.js",
            "types": "./dist/Components/Inputs/PrimitiveInputs.d.ts"
        },
        "./file-input": {
            "import": "./dist/Components/Inputs/PrimitiveInputs.js",
            "types": "./dist/Components/Inputs/PrimitiveInputs.d.ts"
        },
        "./number-input": {
            "import": "./dist/Components/Inputs/NumberInput.js",
            "types": "./dist/Components/Inputs/NumberInput.d.ts"
        },
        "./otp-input": {
            "import": "./dist/Components/Inputs/OtpInput.js",
            "types": "./dist/Components/Inputs/OtpInput.d.ts"
        },
        "./phone-input": {
            "import": "./dist/Components/Inputs/PhoneInput.js",
            "types": "./dist/Components/Inputs/PhoneInput.d.ts"
        },
        "./email-input": {
            "import": "./dist/Components/Inputs/EmailInput.js",
            "types": "./dist/Components/Inputs/EmailInput.d.ts"
        },
        "./money-input": {
            "import": "./dist/Components/Inputs/MoneyInput.js",
            "types": "./dist/Components/Inputs/MoneyInput.d.ts"
        },
        "./password-input": {
            "import": "./dist/Components/Inputs/PasswordInput.js",
            "types": "./dist/Components/Inputs/PasswordInput.d.ts"
        },
        "./quantity-input": {
            "import": "./dist/Components/Inputs/QuantityInput.js",
            "types": "./dist/Components/Inputs/QuantityInput.d.ts"
        },
        "./time-input": {
            "import": "./dist/Components/Inputs/TimeInput.js",
            "types": "./dist/Components/Inputs/TimeInput.d.ts"
        },
        "./textarea": {
            "import": "./dist/Components/Inputs/Textarea.js",
            "types": "./dist/Components/Inputs/Textarea.d.ts"
        },
        "./types": {
            "import": "./dist/types.js",
            "types": "./dist/types.d.ts"
        },
        "./messages": {
            "import": "./dist/messages.js",
            "types": "./dist/messages.d.ts"
        },
        "./package.json": "./package.json",
        "./input.css": "./styles/input.css",
        "./text-input.css": "./styles/text-input.css"
    },
    "packageManager": "bun@1.4.2"
}
